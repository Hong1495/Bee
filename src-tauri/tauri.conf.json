{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bee",
  "version": "0.1.8",
  "identifier": "studio.bee.vinyl",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bee",
        "width": 1320,
        "height": 840,
        "minWidth": 880,
        "minHeight": 660,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "backgroundColor": "#00000000",
        "transparent": true,
        "windowEffects": {
          "effects": [
            "liquidGlassRegular",
            "sidebar"
          ]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/artwork-v2/*",
          "$APPCACHE/local-artwork/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    },
    "resources": {
      "icons/compiled/Assets.car": "Assets.car"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwRDU1OTFBQUZDMzU0MkQKUldRdFZNT3ZHbG5Wc0VHNXFIdFJPRXJzd0p5N1o0Sjl3V0VYclMvOXA4bXZ4d3JJdjQ1d1hyeUEK",
      "endpoints": [
        "https://github.com/Hong1495/Bee/releases/latest/download/latest.json"
      ]
    }
  }
}
